# Copy to .env locally. On Render, add the same keys in Environment (no .env file).

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/
MONGODB_DB_NAME=TW-Quantus

# Admin (/admin)
ADMIN_EMAIL=twquantus2025@gmail.com
ADMIN_PASSWORD=TW-Quantus
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
NEWS_API_KEY=
PING_MESSAGE=ping

# ---
# Render (https://render.com): Web Service
# - Build:  npm install && npm run build
# - Start:  npm start   (serves API + SPA from dist/spa on PORT)
# - Set all variables above in the service Environment tab.
# - Atlas: Network Access → allow Render outbound IPs or 0.0.0.0/0 for testing.
